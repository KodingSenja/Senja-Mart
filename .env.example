[TEMPLATE]
# === Supabase (Senja Mart data layer) ===
# Copy this file to .env.local and fill in the values from
# https://supabase.com/dashboard/project/_/settings/api
#
# These are PUBLIC variables (safe for the browser). Without them the
# storefront runs on the seeded dataset (src/lib/data) so the UI keeps
# working during development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never prefix with NEXT_PUBLIC, never expose in the browser)
# Optional: only needed for admin bootstrapping outside RLS.
SUPABASE_SERVICE_ROLE_KEY=

# === Midtrans Snap (Senja Mart checkout) ===
# Get keys from https://dashboard.sandbox.midtrans.com/settings/config_info
# (Sandbox) or https://dashboard.midtrans.com (Production).
#
# Client Key is PUBLIC (loaded by snap.js in the browser).
# Server Key is SERVER-ONLY — never prefix with NEXT_PUBLIC.

NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# true = production (app.midtrans.com / api.midtrans.com), default = sandbox
MIDTRANS_IS_PRODUCTION=

# === AI Business Assistant (SenjaMart admin) ===
# Server-only key (OpenRouter). Never prefix with NEXT_PUBLIC.
# Get it from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional provider overrides (OpenAI-compatible chat completions).
# Model id as OpenRouter expects it, e.g. openai/gpt-4o-mini.
AI_MODEL=
AI_BASE_URL=

# === Admin / test credentials (server-only, used by scripts) ===
# Login used by the E2E and integration scripts under scripts/.
IT_ADMIN_EMAIL=
IT_PASSWORD=
# Password for the seeded E2E test customer (scripts/e2e-*.mjs).
E2E_CUST_PASSWORD=

# === Optional ===
# basePath/assetPrefix for deploying under a sub-path (next.config.js).
# NEXT_PUBLIC_BASE_PATH=
